# Frontend build-time environment template. Copy to frontend/.env for local runs.
# Create React App inlines REACT_APP_* values into the JavaScript bundle at build
# time, so never put secrets here.

# Base URL of the API, with no trailing slash.
# The app requests ${REACT_APP_BACKEND_URL}/api for the public site and
# ${REACT_APP_BACKEND_URL}/api/v1/admin for the invoice workspace.
#
# Leave this EMPTY when the API is served from the same origin as the site
# (recommended in production). The admin session cookie is SameSite=Lax, so a
# separate API origin would prevent the browser from sending it and logins would fail.
REACT_APP_BACKEND_URL=

# Local development against a backend on port 8001:
# REACT_APP_BACKEND_URL=http://localhost:8001
