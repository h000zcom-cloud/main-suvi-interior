# Backend environment template. Copy to backend/.env for local runs and set the same
# keys as environment variables on the host. Never commit a filled-in .env file.

# --- Required ---------------------------------------------------------------
# MongoDB connection string. MongoDB Atlas issues a mongodb+srv:// URI.
MONGO_URL=mongodb://localhost:27017
DB_NAME=suvi_interior

# Legacy key for the public enquiry admin endpoints.
# Use a long random value; it is not the invoice admin password.
ADMIN_KEY=

# --- Invoice admin workspace -----------------------------------------------
# Credentials for the private invoice workspace owner account. The owner is created
# on first startup. Set a strong password before the first deploy: if
# INVOICE_ADMIN_PASSWORD is empty, startup falls back to ADMIN_KEY and logs a warning.
INVOICE_ADMIN_USERNAME=
INVOICE_ADMIN_PASSWORD=

# Session cookie transport. Leave unset (defaults to true) in production so the
# session cookie is only sent over HTTPS. Set to false only for local HTTP.
# INVOICE_ADMIN_COOKIE_SECURE=true

# Session lifetime in hours (1 to 720). Defaults to 12.
# INVOICE_ADMIN_SESSION_HOURS=12

# bcrypt cost factor (10 to 14). Defaults to 12. Lower values are faster but weaker.
# INVOICE_ADMIN_BCRYPT_ROUNDS=12

# --- CORS -------------------------------------------------------------------
# Comma-separated list of exact browser origins, no trailing slash.
# Required for credentialed requests: the wildcard default disables credentials.
# Omit entirely when the frontend and API are served from the same origin.
# CORS_ORIGINS=https://www.example.com
